# 복사해서 .env 로 쓴다 (.env 는 커밋하지 않는다)
POSTGRES_USER=recsys
POSTGRES_PASSWORD=recsys
POSTGRES_DB=recsys
# docker 없이 로컬에서 API만 띄울 때 (기본값은 SQLite)
# DATABASE_URL=sqlite:///./local.db
# 검색 모델을 한 번 받은 뒤 1로 바꾸면 시작할 때 인터넷 확인을 건너뛴다 (모델 교체 · 첫 실행에는 0)
HF_HUB_OFFLINE=0
# 관리자 쓰기 엔드포인트 (POST /models · /models/{id}/activate · /experiments · /experiments/{id}/stop) 인증 키.
# 비어 있으면 로컬 개발용으로 통과 (서버 시작 시 WARN). 운영에서는 길고 무작위한 값으로 설정.
# 대시보드 컨테이너에도 같은 값을 전달해야 '교체' 버튼이 통한다 (docker-compose.yml 참고).
ADMIN_API_KEY=
